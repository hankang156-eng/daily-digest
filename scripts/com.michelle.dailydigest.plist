<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.michelle.dailydigest</string>

    <key>ProgramArguments</key>
    <array>
        <string>__RUNNER__</string>
        <string>--scheduled</string>
    </array>

    <!-- Run at 6:00 AM, with hourly retry slots through 11:00 AM. With
         scheduled set, run_digest.sh exits at once when the day's digest is
         already built and published, so the later slots only matter when an
         earlier one had no network or did not finish. A slot missed while
         the Mac sleeps fires once at the next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/com.michelle.dailydigest.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.michelle.dailydigest.err.log</string>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
