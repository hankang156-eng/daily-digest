# Copy to .env (gitignored) and fill in. scripts/run_digest.sh sources this file
# for both manual and scheduled (LaunchAgent) runs.

# Required only when opting into LLM summaries with --summary-provider gemini.
GEMINI_API_KEY=

# Required for NYT article word counts (Article Search API). Free key from
# https://developer.nytimes.com — enable the "Article Search API". Without it,
# NYT reading stats are skipped (no error).
NYT_API_KEY=

# Required only when using --summary-provider claude-sonnet / claude-opus.
ANTHROPIC_API_KEY=
